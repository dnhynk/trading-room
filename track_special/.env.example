# Public observe/replay does not require credentials.
ARX_TRADING_ROOM_HOME=

# Keep read-only UTA management/trade credentials separate from any later
# trade-enabled credential. Do not grant withdrawal or transfer permissions.
ARX_BITGET_READ_API_KEY=
ARX_BITGET_READ_API_SECRET=
ARX_BITGET_READ_API_PASSPHRASE=

# Intentionally unused by the current implementation. A later live review must
# wire this credential explicitly; copying read credentials here enables nothing.
ARX_BITGET_TRADE_API_KEY=
ARX_BITGET_TRADE_API_SECRET=
ARX_BITGET_TRADE_API_PASSPHRASE=
